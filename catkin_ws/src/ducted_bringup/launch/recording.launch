<launch>
  <arg name="directory" default="/home/nrc/catkin_ws/logs/recordings" />
  <arg name="base_ready_topic" default="/ducted/system/ready" />
  <arg name="base_timeout" default="15.0" />
  <arg name="split_mb" default="512" />
  <node pkg="ducted_bringup" type="record_topics.py" name="ducted_recording" output="screen" required="true">
    <param name="directory" value="$(arg directory)" />
    <param name="base_ready_topic" value="$(arg base_ready_topic)" />
    <param name="base_timeout" value="$(arg base_timeout)" />
    <param name="split_mb" value="$(arg split_mb)" type="int" />
    <rosparam param="topics">[/diagnostics, /tf, /tf_static, /mavros/state, /mavros/extended_state, /mavros/rc/in, /mavros/imu/data, /mavros/estimator_status, /mavros/odometry/out, /mavros/odometry/in, /mavros/local_position/pose, /mavros/setpoint_position/local, /livox/lidar, /livox/imu, /ducted/system/ready, /ducted/localization/odom, /ducted/localization/path, /ducted/mapping/cloud_registered, /ducted/relocalization/registered_scan, /ducted/external_odometry/ready, /ducted/relocalization/ready, /ducted/terrain/height, /ducted/terrain/ready, /ducted/rc/state, /ducted/control/target, /ducted/control/status, /ducted/control/ready, /ducted/navigation/status, /ducted/navigation/preview, /ducted/mission/status]</rosparam>
  </node>
</launch>
