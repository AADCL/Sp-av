<launch>
  <!-- Base and localization must be ready. Height is measured or explicitly initialized for bounded takeoff. -->
  <arg name="enable_commands" default="false" />
  <arg name="height_mode" default="terrain" />
  <arg name="takeoff_reference_z" default="0.0" />
  <arg name="relative_reference_file" default="" />
  <arg name="slow_land_speed" default="0.2" />
  <arg name="enable_flight_output" default="false" />
  <arg name="enable_navigation_output" default="false" />
  <arg name="geometry_confirmed" default="false" />
  <arg name="mapping_confirmed" default="false" />
  <arg name="start_rc_monitor" default="true" />
  <arg name="finish" default="hold" />
  <arg name="takeoff_rise" default="1.1" />
  <arg name="takeoff_agl" default="0.0" />
  <arg name="ground_reference_file" default="" />
  <arg name="mission_file" default="$(find ducted_mission)/config/mission.yaml" />
  <arg name="navigation_config" default="$(find ducted_navigation)/config/local_avoidance.yaml" />
  <arg name="cloud_topic" default="/ducted/relocalization/registered_scan" />
  <include file="$(find ducted_bringup)/launch/flight_control.launch">
    <arg name="height_mode" value="$(arg height_mode)" />
    <arg name="takeoff_reference_z" value="$(arg takeoff_reference_z)" />
    <arg name="slow_land_speed" value="$(arg slow_land_speed)" />
    <arg name="enable_flight_output" value="$(arg enable_flight_output)" />
    <arg name="require_automatic_lease" value="true" />
    <arg name="start_rc_monitor" value="$(arg start_rc_monitor)" />
    <arg name="mapping_confirmed" value="$(arg mapping_confirmed)" />
  </include>
  <include file="$(find ducted_bringup)/launch/ego_planner.launch">
    <arg name="enable_output" value="$(arg enable_navigation_output)" />
    <arg name="geometry_confirmed" value="$(arg geometry_confirmed)" />
    <arg name="cloud_topic" value="$(arg cloud_topic)" />
    <arg name="config_file" value="$(arg navigation_config)" />
  </include>
  <include file="$(find ducted_bringup)/launch/waypoint_mission.launch">
    <arg name="height_mode" value="$(arg height_mode)" />
    <arg name="mission_file" value="$(arg mission_file)" />
    <arg name="enable_commands" value="$(arg enable_commands)" />
    <arg name="require_automatic_lease" value="true" />
  </include>
  <include file="$(find ducted_bringup)/launch/automatic_sequence.launch">
    <arg name="height_mode" value="$(arg height_mode)" />
    <arg name="relative_reference_file" value="$(arg relative_reference_file)" />
    <arg name="enable_commands" value="$(arg enable_commands)" />
    <arg name="finish" value="$(arg finish)" />
    <arg name="takeoff_rise" value="$(arg takeoff_rise)" />
    <arg name="takeoff_agl" value="$(arg takeoff_agl)" />
    <arg name="ground_reference_file" value="$(arg ground_reference_file)" />
    <arg name="cloud_topic" value="$(arg cloud_topic)" />
  </include>
</launch>
