<launch>
  <arg name="map_file" default="/home/nrc/catkin_ws/maps/GlobalMap.pcd" />
  <arg name="base_ready_topic" default="/ducted/system/ready" />
  <arg name="base_ready_timeout" default="15.0" />
  <arg name="use_global_relocalizer" default="true" />
  <arg name="auto_initialize" default="true" />
  <arg name="localization_python" default="/home/nrc/catkin_ws/.venv-localization/bin/python3" />

  <!-- Automatic unknown-pose search + RViz manual initialization; no TF publisher here. -->
  <node if="$(arg use_global_relocalizer)" pkg="ducted_localization" type="global_relocalizer.py"
        name="global_relocalizer" launch-prefix="$(arg localization_python)" output="screen" required="true" clear_params="true">
    <rosparam command="load" file="$(find ducted_localization)/config/global_relocalization.yaml" />
    <rosparam command="load" file="$(find ducted_bringup)/config/external_odometry.yaml" />
    <param name="map_file" value="$(arg map_file)" />
    <param name="auto_initialize" value="$(arg auto_initialize)" />
    <param name="base_ready_topic" value="$(arg base_ready_topic)" />
  </node>

  <include file="$(find ducted_bringup)/launch/localization_frames.launch">
    <arg name="base_ready_topic" value="$(arg base_ready_topic)" />
  </include>
  <include file="$(find ducted_bringup)/launch/local_odometry.launch">
    <arg name="base_ready_topic" value="$(arg base_ready_topic)" />
  </include>
  <node pkg="ducted_bringup" type="world_tf_owner.py" name="world_tf_owner" output="screen" required="true">
    <rosparam command="load" file="$(find ducted_bringup)/config/external_odometry.yaml" />
    <remap from="local" to="/ducted/localization/body_odom" />
    <remap from="global" to="/ducted/relocalization/global_odom" />
    <remap from="localized" to="/ducted/relocalization/ready" />
    <remap from="base_ready" to="$(arg base_ready_topic)" />
    <remap from="ready" to="/ducted/localization/map_ready" />
  </node>

  <rosparam unless="$(arg use_global_relocalizer)" command="load" file="$(find ducted_bringup)/config/relocalization_mid360.yaml" />

  <!-- Retained for an explicit rollback; never run both global backends together. -->
  <node unless="$(arg use_global_relocalizer)" pkg="sfast_lio"
        type="sfastlio_mapping_relocalization"
        name="relocalization"
        output="screen"
        required="true">
    <param name="globalmap_dir" value="$(arg map_file)" />
    <param name="publish_tf" value="false" />
    <param name="require_base_ready" value="true" />
    <param name="base_ready_topic" value="$(arg base_ready_topic)" />
    <param name="base_ready_timeout" value="$(arg base_ready_timeout)" />

    <remap from="/livox/lidar" to="/livox/lidar" />
    <remap from="/livox/imu" to="/livox/imu" />
    <remap from="/initialpose" to="/ducted/relocalization/initialpose" />
    <remap from="/Odometry" to="/ducted/relocalization/global_odom" />
    <remap from="/path" to="/ducted/relocalization/path" />
    <remap from="/Odometry_relocal" to="/ducted/relocalization/scan_matching_odom" />
    <remap from="/gobal_map_relocal" to="/ducted/relocalization/global_map" />
    <remap from="/local_map_relocal" to="/ducted/relocalization/local_map" />
    <remap from="/registed_current_scan" to="/ducted/relocalization/registered_scan" />
    <remap from="/beforeRegisted" to="/ducted/relocalization/initial_guess_cloud" />
    <remap from="/initguess" to="/ducted/relocalization/initial_guess_marker" />
    <remap from="/relocalization_ready" to="/ducted/relocalization/ready" />
    <remap from="/cloud_registered" to="/ducted/relocalization/cloud_registered" />
    <remap from="/cloud_registered_body" to="/ducted/relocalization/cloud_body" />
  </node>
</launch>
